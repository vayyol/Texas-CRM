# ============================================================
# AI SaaS Starter Kit — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="AI SaaS Starter Kit"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_USER=saas_user
DB_PASSWORD=change_me_in_production
DB_NAME=saas_db
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ─── Security / JWT ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string
REFRESH_SECRET_KEY=CHANGE_ME_generate_another_random_64_char_string
SESSION_SECRET=CHANGE_ME_generate_yet_another_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Asaas (pagamentos e assinaturas) ───────────────────────
# Chaves em: Asaas > Integrações > Chaves de API. Sandbox e produção usam chaves DIFERENTES:
#   sandbox  -> começa com $aact_hmlg_   (ASAAS_ENVIRONMENT=sandbox)
#   produção -> começa com $aact_prod_   (ASAAS_ENVIRONMENT=production)
# ATENÇÃO: a chave contém "$". No docker-compose/.env escreva cada "$" como "$$" para o compose
# não tratá-lo como variável. Na Render, cole a chave normalmente no painel de variáveis.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Token que o Asaas envia no header "asaas-access-token" em cada webhook. Invente um valor
# aleatório com no mínimo 32 caracteres (NÃO reutilize a chave da API):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use o MESMO valor ao cadastrar o webhook no Asaas (campo "Token de autenticação").
ASAAS_WEBHOOK_TOKEN=
# Validade do link de pagamento, em minutos (o Asaas aceita de 10 a 1440).
ASAAS_CHECKOUT_MINUTES_TO_EXPIRE=60

# ─── Stripe (LEGADO — não é mais usado; mantido só durante a transição) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ─── AI / OpenAI ─────────────────────────────────────────────
# Works with any OpenAI-compatible API (OpenAI, Azure, local models)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
